 CHIP Memory {
      IN in[16], load, address[15];
      OUT out[16];
    // Decode the address to select RAM or Screen/Keyboard
    DMux(
        in=load,
        sel=address[14],
        a=loadRAM,
        b=loadScreenKeyboard
    );

    // Screen is selected when address[14] = 1
    // and address[13] = 0
    Not(in=address[13], out=notAddress13);

    And(
        a=loadScreenKeyboard,
        b=notAddress13,
        out=loadScreen
    );

    // RAM16K
    RAM16K(
        in=in,
        load=loadRAM,
        address=address[0..13],
        out=ramOut
    );

    // Screen memory
    Screen(
        in=in,
        load=loadScreen,
        address=address[0..12],
        out=screenOut
    );

    // Keyboard memory
    Keyboard(
        out=keyboardOut
    );

    // Select Screen or Keyboard output
    Mux16(
        a=screenOut,
        b=keyboardOut,
        sel=address[13],
        out=screenKeyboardOut
    );

    // Select RAM or Screen/Keyboard output
    Mux16(
        a=ramOut,
        b=screenKeyboardOut,
        sel=address[14],
        out=out
    );
 }